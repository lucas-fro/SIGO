# Banco local de desenvolvimento (NÃO aponte para produção). O banco é criado
# sozinho por `npm run db:create` se ainda não existir.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/sigo

# Opcional. Só serve para criar o banco e, vazio, sai do DATABASE_URL acima
# trocando o nome do banco por `postgres`.
#ADMIN_DATABASE_URL=postgresql://outro-usuario:senha@localhost:5432/postgres

# Administrador garantido por `npm run usuarios -- seed-admin`. A senha daqui é
# reaplicada a cada execução: é a forma de recuperar acesso.
ADMIN_EMAIL=admin@sigo.local
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# Opcional. Em branco, a chave que assina o cookie de sessão sai da senha do admin.
#AUTH_SECRET=
AUTH_SESSION_DAYS=7

# 3340 e 3040 para não disputar porta com o Painel Sienge (3333 e 3000).
PORT=3340
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3040
