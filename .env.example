# ---------------------------------------------------------------------------
# Produção. Copie para `.env` na VPS e preencha. Este arquivo é lido pelo
# docker compose e repassado ao container do backend.
# ---------------------------------------------------------------------------

# Postgres que já roda na VPS (SmartInfra). O host é o nome do container na
# rede `web`, não `localhost`. O banco `sigo` é criado na primeira subida.
DATABASE_URL=postgresql://usuario:senha@postgres:5432/sigo

# Opcional. Só serve para criar o banco na primeira subida; vazio, sai do
# DATABASE_URL trocando o nome do banco por `postgres`.
#ADMIN_DATABASE_URL=postgresql://outro-usuario:senha@postgres:5432/postgres

# Administrador garantido a cada subida. Os demais usuários são cadastrados
# pela linha de comando (ver DEPLOY.md). A senha daqui é reaplicada a cada
# subida: é a forma de recuperar acesso. Troque a de exemplo: com ela o
# backend não sobe em produção.
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# Obrigatório. Segredo que assina o cookie de sessão e cifra a chave da IA no
# banco. Gere com:  openssl rand -base64 48
# Trocar derruba as sessões abertas e pede a chave da IA de novo.
AUTH_SECRET=

# Dias que a sessão dura sem precisar entrar de novo.
AUTH_SESSION_DAYS=7

# Com front e API no mesmo domínio as chamadas são same-origin e isto nem é
# consultado; fica preenchido para o caso de separar os domínios depois.
CORS_ORIGIN=https://sigo.smartinterno.com

# Endereço da API embutido na build do front. Mudar exige
# `docker compose build frontend`.
PUBLIC_API_BASE=/api

# API do Sienge (só leitura), para o quadro "No Sienge em <mês>" do dashboard.
# Sem as três, o quadro aparece como sem conexão e nada é chamado. O ideal é um
# usuário de API próprio do SIGO, criado no Painel de Integrações do Sienge.
# Deixe em branco até ter o usuário de verdade (preenchidas, a conferência roda).
SIENGE_SUBDOMAIN=
SIENGE_USER=
SIENGE_PASSWORD=
# O limite de 200 req/min vale para o subdomínio inteiro e é dividido com o
# Painel Sienge (que usa até 150): o SIGO fica com pouco.
SIENGE_RATE_LIMIT_PER_MINUTE=40
# Horários (São Paulo) da conferência de pagamentos: as parcelas em aberto que
# estão pagas no Sienge são marcadas como pagas no SIGO. Vazio desliga.
SIENGE_CONFERENCIA_HORARIOS=00:00,12:00

# Pasta dos comprovantes dentro do container (montada como volume no compose).
COMPROVANTES_DIR=dados/comprovantes

# A chave da IA que lê os comprovantes NÃO fica aqui: o admin cadastra na tela,
# em Cadastros → Leitura por IA. Ela é guardada no banco cifrada com o
# AUTH_SECRET: trocar esse segredo pede a chave de novo.

# Passos do entrypoint do backend. Deixe em `true`. Se o usuário do SIGO não
# pode criar banco no Postgres compartilhado, crie o banco à mão e use false.
CREATE_DATABASE=true
RUN_MIGRATIONS=true
SEED=true
