# ---------------------------------------------------------------------------
# Produção. Copie para `.env` na VPS e preencha. Este arquivo é lido pelo
# docker compose e repassado ao container do backend.
# ---------------------------------------------------------------------------

# Postgres que já roda na VPS (SmartInfra). O host é o nome do container na
# rede `web`, não `localhost`. O banco `sigo` é criado na primeira subida.
DATABASE_URL=postgresql://usuario:senha@postgres:5432/sigo

# Opcional. Só serve para criar o banco na primeira subida; vazio, sai do
# DATABASE_URL trocando o nome do banco por `postgres`.
#ADMIN_DATABASE_URL=postgresql://outro-usuario:senha@postgres:5432/postgres

# Administrador garantido a cada subida. Os demais usuários são cadastrados
# pela linha de comando (ver DEPLOY.md). A senha daqui é reaplicada a cada
# subida: é a forma de recuperar acesso.
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# Opcional. Em branco, a chave que assina o cookie de sessão é derivada da senha
# do admin, e trocar aquela senha invalida as sessões abertas.
#AUTH_SECRET=

# Dias que a sessão dura sem precisar entrar de novo.
AUTH_SESSION_DAYS=7

# Com front e API no mesmo domínio as chamadas são same-origin e isto nem é
# consultado; fica preenchido para o caso de separar os domínios depois.
CORS_ORIGIN=https://sigo.smartinterno.com

# Endereço da API embutido na build do front. Mudar exige
# `docker compose build frontend`.
PUBLIC_API_BASE=/api

# Passos do entrypoint do backend. Deixe em `true`.
CREATE_DATABASE=true
RUN_MIGRATIONS=true
SEED=true
